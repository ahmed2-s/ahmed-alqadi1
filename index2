            <div class="hero-cta">
                <a href="#contact" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> تواصل معي الآن</a>
                <a href="javascript:window.print()" class="btn btn-secondary"><i class="fa-solid fa-file-pdf"></i> طباعة / حفظ السيرة الذاتية</a>
            </div>
        </div>
    </section>

    <!-- Highlight Metrics Section (6 Cards Symmetrical Layout) -->
    <div class="metrics-section">
        <div class="metrics-grid">
            <div class="metric-card">
                <span class="metric-number">+2 سنة</span>
                <span class="metric-label">الخبرة العملية في المكاتب الاستشارية</span>
            </div>
            <div class="metric-card">
                <span class="metric-number" style="color: var(--purple);">Tax Audit</span>
                <span class="metric-label">خبير الفحص واللجان الضريبية</span>
            </div>
            <div class="metric-card">
                <span class="metric-number">SAP Tax</span>
                <span class="metric-label">خبير في منظومة الضرائب الجديدة SAP</span>
            </div>
            <div class="metric-card">
                <span class="metric-number">ERP & Excel</span>
                <span class="metric-label">إتقان متقدم للبرامج والأنظمة المحاسبية</span>
            </div>
            <div class="metric-card">
                <span class="metric-number">E-Invoice</span>
                <span class="metric-label">إدارة الفواتير الإلكترونية Invoicing Portal</span>
            </div>
            <div class="metric-card">
                <span class="metric-number">Tax Returns</span>
                <span class="metric-label">تقديم إقرارات الدخل والقيمة المضافة</span>
            </div>
        </div>
    </div>

    <!-- About Section: 4 Professional Pillars in Perfect Order -->
    <section id="about">
        <div class="section-header">
            <h2 class="section-title">الركائز المهنية الأساسية</h2>
        </div>
        <div class="grid-pillars">
            <!-- 1. منظومتا الضرائب -->
            <div class="card">
                <div class="card-icon" style="color: var(--sap-blue); background: rgba(2, 132, 199, 0.12);"><i class="fa-solid fa-server"></i></div>
                <h3>منظومتا الضرائب (SAP & القديمة)</h3>
                <p style="color: var(--text-muted); margin-top: 0.5rem;">خبرة تخصصية عميقة في استخدام وتدقيق العمليات عبر منظومة الضرائب المصرية الجديدة القائمة على نظام SAP والمنظومة الإلكترونية القديمة والتكامل مع الميكنة الشاملة.</p>
            </div>
            <!-- 2. الفحص واللجان الضريبية (الجديدة) -->
            <div class="card">
                <div class="card-icon" style="color: var(--purple); background: rgba(139, 92, 246, 0.12);"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
                <h3>الفحص واللجان الضريبية</h3>
                <p style="color: var(--text-muted); margin-top: 0.5rem;">خبرة متقدمة في إعداد وتجهيز ملفات الفحص الضريبي (دخل، قيمة مضافة، كسب عمل)، تجهيز المستندات والشيتات التحليلية، والمتابعة الاحترافية أمام المأموريات ولجان الطعن.</p>
            </div>
            <!-- 3. تقديم الإقرارات الضريبية -->
            <div class="card">
                <div class="card-icon" style="color: var(--gold); background: rgba(245, 158, 11, 0.12);"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                <h3>إقرارات الدخل والقيمة المضافة</h3>
                <p style="color: var(--text-muted); margin-top: 0.5rem;">الإعداد والدراسة والتقديم المعتمد لإقرارات ضريبة الدخل وضريبة القيمة المضافة (VAT) والتسويات الضريبية وفق اللوائح والمعايير المعتمدة.</p>
            </div>
            <!-- 4. الفواتير الإلكترونية -->
            <div class="card">
                <div class="card-icon" style="color: var(--emerald); background: rgba(16, 185, 129, 0.12);"><i class="fa-solid fa-receipt"></i></div>
                <h3>إدارة الفواتير الإلكترونية (Invoicing Portal)</h3>
                <p style="color: var(--text-muted); margin-top: 0.5rem;">إدارة كاملة لمنظومة الفاتورة الإلكترونية والإيصال الإلكتروني، المراجعة، الإصدار، التأكيد، والربط المباشر مع بوابة مصلحة الضرائب.</p>
            </div>
        </div>
    </section>

    <!-- Experience Section -->
    <section id="experience">
        <div class="section-header">
            <h2 class="section-title">الخبرات المهنية</h2>
        </div>
        <div class="timeline">

            <!-- AGAC Experience -->
            <div class="timeline-item active">
                <div class="timeline-date">
                    <i class="fa-regular fa-calendar-check"></i> أغسطس 2026 – حتى الآن
                    <span class="timeline-badge">الحالي</span>
                </div>
                <h3 class="timeline-title">محاسب ومختص ضرائب وفحص ضريبي</h3>
                <div class="timeline-subtitle">AGAC - المجموعة الاستشارية للمحاسبة والاستشارات الضريبية</div>
                <ul class="timeline-list">
